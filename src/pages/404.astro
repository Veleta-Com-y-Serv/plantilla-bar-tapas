---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="banda banda--papel">
    <div class="contenedor partido">
      <p class="error-cifra" aria-hidden="true">404</p>
      <div class="titular medida">
        <p class="antetitulo">Página no encontrada</p>
        <h1 class="titulo-seccion ajusta" style="--letras:9">Esta tapa ya no está.</h1>
        <p class="entrada">Puede que el enlace esté mal o que la página se haya movido. Vuelve al inicio y te enseñamos la carta.</p>
        <div class="botones">
          <a class="btn" href="/">Volver al inicio</a>
        </div>
      </div>
    </div>
  </section>
</Base>
